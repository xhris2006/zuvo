# -----------------------------------------------------------------------------
# Zuvo — variables d'environnement
# Copiez ce fichier en `.env.local` pour le développement local.
# Ne commitez JAMAIS de vraies valeurs. Toutes les valeurs ci-dessous sont fictives.
# -----------------------------------------------------------------------------

# URL publique du site (sans slash final). Sert aux métadonnées SEO, au sitemap
# et aux liens absolus. Sur Vercel, si elle est absente, l'URL de production
# du projet est utilisée automatiquement.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse e-mail affichée sur la page d'aide / contact (facultatif).
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase — Project Settings > API (ou "API Keys").
# L'URL et la clé publishable (ou "anon" sur les anciens projets) peuvent être
# exposées au navigateur : la sécurité repose sur les politiques RLS.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Serveur uniquement — NE JAMAIS préfixer par NEXT_PUBLIC_, ne jamais commiter.
# À renseigner dans Vercel (Settings > Environment Variables) ou .env.local.
# -----------------------------------------------------------------------------

# Clé secrète Supabase (sb_secret_… ou service_role). Utilisée uniquement par
# l'envoi des notifications push et la suppression de compte.
SUPABASE_SERVICE_ROLE_KEY=

# Notifications push (voir docs/notifications.md). Générez les clés avec
# `npx web-push generate-vapid-keys` sur votre machine.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Adresse de contact du service push, par exemple mailto:contact@votre-domaine.cm
VAPID_SUBJECT=
# Secret partagé avec le webhook Supabase (32 caractères minimum).
PUSH_WEBHOOK_SECRET=
